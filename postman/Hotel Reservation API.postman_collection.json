{
  "info": {
    "_postman_id": "6e7efd2d-a3c4-4483-bdcb-c8b13f493046",
    "name": "Hotel Reservation API",
    "description": "Postman collection for the Hotel Reservation Management API.\n\nRun `Auth / Login` first. The test script stores the returned JWT in the `token` environment variable. Create Hotel and Create Customer store their generated IDs, which are then reused by reservation requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56981753"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.accessToken).to.be.a('string').and.not.empty;",
                  "pm.environment.set('token', response.accessToken);",
                  "",
                  "pm.test('JWT token stored', function () {",
                  "    pm.expect(pm.environment.get('token')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates the local demo user and stores `accessToken` as the `token` environment variable."
          },
          "response": []
        }
      ]
    },
